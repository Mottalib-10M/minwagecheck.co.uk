---
/** Attributions required by the licences (RECETTE §12.1, rule 3). Shown at the foot of every page, embeds included. */
interface Props { class?: string }
const { class: cls = 'text-xs text-navy-500' } = Astro.props;
const OGL = 'https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/';
---
<p class={cls} data-licence-notice>
  Contains public sector information licensed under the <a class="underline" href={OGL} target="_blank" rel="noopener">Open Government Licence v3.0</a>: minimum wage rates, accommodation offsets, tax and National Insurance thresholds and HMRC guidance from GOV.UK, Low Pay Commission publications, and the National Minimum Wage Regulations from legislation.gov.uk; adapted and calculated by Radif Partners.
  Living Wage Foundation rates and Acas guidance are cited and summarised in our own words.
</p>
